# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of this site (used for canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://aryalrajiv.com.np

# Headless WordPress (where you write research posts). No trailing slash.
WORDPRESS_URL=https://cms.aryalrajiv.com.np
# Shared secret WordPress sends to /api/revalidate. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Contact form (Gmail SMTP with an App Password)
EMAIL_USER=
EMAIL_PASS=
YOUR_EMAIL=

# Google reCAPTCHA v2 checkbox
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LdHUYErAAAAADiCbCZJ4rS06iP-KNHj6PnXPxZr
RECAPTCHA_SECRET_KEY=

# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
