# Copy to .env and fill in. Never commit .env.
PORT=3000

# Contact form (Gmail SMTP with an App Password)
EMAIL_USER=
EMAIL_PASS=
YOUR_EMAIL=

# Google reCAPTCHA v2
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# CMS at /admin (local only). Leave empty to turn the CMS off.
ADMIN_PASSWORD=
# Optional: secret used to sign login cookies (defaults to one derived from ADMIN_PASSWORD)
SESSION_SECRET=
